{
  "name": "waqaya",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": "24.x",
    "pnpm": "11.28.8"
  },
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "i18n:check": "node scripts/check-messages.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:seed-admin": "tsx scripts/seed-admin.mts",
    "db:studio": "prisma studio",
    "auth:generate": "auth generate --config lib/auth.ts --output prisma/schema.prisma --yes",
    "auth:check": "auth check schema --config lib/auth.ts",
    "db:drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:bootstrap": "tsx scripts/bootstrap.mts",
    "jobs:purge-photos": "tsx --conditions=react-server scripts/purge-photos.mts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "brand:assets": "tsx scripts/brand-assets.mts",
    "railway:cors": "tsx --conditions=react-server scripts/set-bucket-cors.mts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.90",
    "@ai-sdk/react": "4.0.159",
    "@aws-sdk/client-s3": "3.1158.0",
    "@aws-sdk/s3-request-presigner": "3.1158.0",
    "@base-ui/react": "1.9.0",
    "@better-auth/i18n": "1.7.14",
    "@hookform/resolvers": "6.0.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tanstack/react-table": "9.3.1",
    "ai": "7.0.155",
    "better-auth": "1.7.14",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.0",
    "date-fns": "4.4.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.62.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "prisma": "7.10.1",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "recharts": "3.8.0",
    "server-only": "0.0.1",
    "shadcn": "4.23.0",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "auth": "1.7.14",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
