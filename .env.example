# Waqaya environment variables. Copy to .env.local for local development (gitignored).
# On Railway set them as service variables (secrets sealed). Never prefix secrets with NEXT_PUBLIC_.

# --- Database (Prisma 7 + @prisma/adapter-pg) -------------------------------------------------------
# Local: Docker Postgres 18. Railway: ${{Postgres.DATABASE_URL}} (private network, no sslmode).
DATABASE_URL="postgresql://waqaya:waqaya_dev@127.0.0.1:5434/waqaya"
# Optional: direct URL for the Prisma CLI when DATABASE_URL points at a pooler (PgBouncer).
# DIRECT_DATABASE_URL=""
# Optional: pg pool size per instance (default 10).
# DATABASE_POOL_MAX="10"

# --- Better Auth -------------------------------------------------------------------------------------
# >= 32 random bytes, different per environment:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
# The public origin of this environment (fixed per environment; never a *.up.railway.app wildcard).
# Also the site URL for metadata, canonical/hreflang links and the sitemap, and it decides HSTS (https only).
# Those are computed at BUILD time: after changing it, rebuild (redeploy), do not just restart.
BETTER_AUTH_URL="http://localhost:3000"
# Optional extra trusted origins, comma-separated with NO spaces (Better Auth reads this itself).
# BETTER_AUTH_TRUSTED_ORIGINS="https://waqaya.example,https://www.waqaya.example"

# --- AI (Vercel AI SDK + @ai-sdk/anthropic) ---------------------------------------------------------
# Without it the app runs and AI features show "AI not configured".
ANTHROPIC_API_KEY=""
# Model id (admin panel setting "ai.model" overrides it). Default claude-opus-5-5.
AI_MODEL="claude-opus-5-5"
# Effort: low | medium | high | xhigh | max (admin setting "ai.effort" overrides it). Default medium.
AI_EFFORT="medium"
# AI calls per user per day, Asia/Riyadh calendar day (admin setting "ai.dailyLimitPerUser" overrides it).
AI_DAILY_LIMIT_PER_USER="20"

# --- Photo storage: Railway bucket (S3-compatible) ---------------------------------------------------
# Unset locally = "storage not configured" (scan uploads show a clear message instead of crashing).
# Railway: ${{scans.ENDPOINT}}, ${{scans.REGION}}, ${{scans.BUCKET}}, ${{scans.ACCESS_KEY_ID}}, ${{scans.SECRET_ACCESS_KEY}}
S3_ENDPOINT=""
S3_REGION="auto"
# The bucket's BUCKET variable (name + hash), not RAILWAY_BUCKET_NAME.
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# "virtual" (default, new buckets) or "path" (older buckets, see the bucket Credentials tab).
S3_URL_STYLE="virtual"
# Script only (pnpm railway:cors): origins allowed to PUT/GET photos, comma-separated.
# CORS_ORIGINS="https://waqaya.example,http://localhost:3000"
# The Content-Security-Policy allows exactly this bucket's origin and is fixed at BUILD time: after changing
# any S3_* value, redeploy (rebuild) and check /api/health `checks.csp`.
# Days a finalised scan keeps its photos before the daily job deletes them (1..3650, default 90).
# The admin setting "scans.photoRetentionDays" overrides it. An invalid value stops the job (it never guesses).
# PHOTO_RETENTION_DAYS="90"

# --- Email (verification codes, password reset, invitations) ----------------------------------------
# "cloudflare" (production) | "console" (development only: logs subject + code/link, refused in production)
# | "file" (end-to-end tests only: appends JSON lines to EMAIL_FILE_SINK; refused unless WAQAYA_E2E=1,
# BETTER_AUTH_URL is a loopback http:// origin and no RAILWAY_* ids are set — note 09 §3.4).
# Unset = email off (the app still boots and says so).
EMAIL_PROVIDER="console"
EMAIL_FROM="وقاية Waqaya <waqaya@tirazkit.com>"
# Cloudflare Email Sending REST API (EMAIL_PROVIDER=cloudflare). Token needs Email Sending edit permission.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_EMAIL_API_TOKEN=""

# --- First platform admin (pnpm db:seed-admin) -------------------------------------------------------
# Railway variables only. Run once per environment, then delete ADMIN_INITIAL_PASSWORD.
ADMIN_EMAIL=""
ADMIN_INITIAL_PASSWORD=""
# Optional display name (default "مدير المنصة").
# ADMIN_NAME=""

# --- Logs (lib/log.ts: one JSON line per event on stdout, no personal data) ------------------------------
# debug | info | warn | error (default: info in production, debug otherwise).
# LOG_LEVEL="info"
# "pretty" = readable lines for local debugging; unset = JSON (Railway).
# LOG_FORMAT=""
# Optional key for the e-mail/IP/user-id pseudonyms in logs (default: derived from BETTER_AUTH_SECRET).
# LOG_HASH_KEY=""

# --- End-to-end tests (pnpm e2e, playwright.config.ts) — local and CI only, never on Railway ---------------
# WAQAYA_E2E="1"
# EMAIL_FILE_SINK=".e2e/mail.jsonl"
# E2E_DATABASE_URL="postgresql://waqaya:waqaya_dev@127.0.0.1:5434/waqaya_e2e"
# E2E_PORT="3100"
# Local browser: Edge by default (no download); or point at a cached Chromium build.
# E2E_CHANNEL="msedge"
# E2E_CHROMIUM_PATH=""

# --- Misc --------------------------------------------------------------------------------------------
# Silences Prisma's "update available" banner (npm latest is Prisma 8; stay on 7.10.1).
PRISMA_HIDE_UPDATE_MESSAGE="1"
# Build output folder (default .next). Parallel local builds use their own: NEXT_DIST_DIR=.next-<name>.
# NEXT_DIST_DIR=".next"
