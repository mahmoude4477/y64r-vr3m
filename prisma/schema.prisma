// Waqaya database schema.
// Better Auth tables are generated by `pnpm auth:generate` (source of truth for user/session/account/
// verification/organization/member/invitation/team/teamMember/rateLimit). Domain models follow below.
// After changing lib/auth.ts plugins or additionalFields: pnpm auth:generate -> prisma format ->
// pnpm db:migrate --name <change> -> pnpm db:generate.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // no url here in Prisma 7: it lives in prisma.config.ts
}

model User {
  id                 String              @id
  name               String
  email              String
  emailVerified      Boolean             @default(false)
  image              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  role               String?
  banned             Boolean?            @default(false)
  banReason          String?
  banExpires         DateTime?
  locale             String?             @default("ar")
  profession         String?
  mustChangePassword Boolean?            @default(false)
  sessions           Session[]
  accounts           Account[]
  teammembers        TeamMember[]
  members            Member[]
  invitations        Invitation[]
  // Waqaya domain back-relations (keep when re-running auth:generate)
  protocolsCreated   Protocol[]          @relation("ProtocolCreatedBy")
  simulationAttempts SimulationAttempt[]
  scansExamined      Scan[]              @relation("ScanExaminer")
  scansFinalized     Scan[]              @relation("ScanFinalizer")
  scanPhotos         ScanPhoto[]
  scanStepOverrides  ScanStepResult[]    @relation("ScanStepOverride")
  aiCalls            AiCall[]
  auditLogs          AuditLog[]
  settingsUpdated    AppSetting[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy       String?
  activeOrganizationId String?
  activeTeamId         String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id                 String              @id
  name               String
  slug               String
  logo               String?
  createdAt          DateTime
  metadata           String?
  nameEn             String?
  type               String?
  suspended          Boolean?            @default(false)
  teams              Team[]
  members            Member[]
  invitations        Invitation[]
  // Waqaya domain back-relations (keep when re-running auth:generate)
  protocols          Protocol[]
  scenarios          Scenario[]
  simulationAttempts SimulationAttempt[]
  scans              Scan[]
  scanPhotos         ScanPhoto[]
  aiCalls            AiCall[]

  @@unique([slug])
  @@map("organization")
}

model Team {
  id             String       @id
  name           String
  memberCount    Int          @default(0)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime
  updatedAt      DateTime?    @updatedAt
  teammembers    TeamMember[]
  // Waqaya domain back-relations (keep when re-running auth:generate)
  scans          Scan[]

  @@index([organizationId])
  @@map("team")
}

model TeamMember {
  id            String    @id
  teamId        String
  team          Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipKey String?
  createdAt     DateTime?

  @@unique([membershipKey])
  @@index([teamId])
  @@index([userId])
  @@map("teamMember")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  teamId         String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// ======================================================================================================
// Waqaya domain models. Content is bilingual through Ar/En column pairs (read with lib/i18n-content.ts
// pick()). Enum values are lower_snake (crosscheck D15). Every org-owned row carries organizationId;
// global content has organizationId = null. Read lib/authz.ts before querying any of these.
// ======================================================================================================

enum ProtocolCategory {
  safety
  hygiene
  waste
  maintenance
  other
}

enum Difficulty {
  beginner
  intermediate
  advanced
}

enum StageKind {
  single // pick exactly one option
  multi // pick all that apply
}

enum AttemptStatus {
  in_progress
  completed
  abandoned
}

enum RiskLevel {
  low
  medium
  high
}

enum ScanStatus {
  draft // created, photos being added
  analyzing // AI call in flight
  review // AI done, examiner reviewing
  finalized // examiner finalised; score + risk are final
  failed // AI call failed (refused / error); examiner may retry or review manually
}

// What the AI saw (scan analysis). not_visible = the photo cannot settle the step.

enum StepVerdict {
  compliant
  non_compliant
  not_visible
}

// The examiner's final call. A step left unresolved (null) after not_visible counts as not applicable.

enum FinalVerdict {
  compliant
  non_compliant
  not_applicable
}

enum AiCallKind {
  scan_analysis
  simulation_debrief
  insight
}

enum AiCallStatus {
  pending // reserved before the model call (lib/ai/limits.ts reserveAiCall), updated when it ends
  ok
  refused
  error
}

// A protocol. Global when organizationId is null; an institution's custom protocol otherwise
// (sourceProtocolId set when it was copied from a global one).

model Protocol {
  id               String           @id @default(cuid())
  slug             String           @unique
  organizationId   String?
  organization     Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category         ProtocolCategory
  titleAr          String
  titleEn          String
  summaryAr        String
  summaryEn        String
  descriptionAr    String
  descriptionEn    String
  /// lucide-react icon name in kebab-case, e.g. "syringe" (components/shared/protocol-icon.tsx)
  icon             String
  isPublished      Boolean          @default(false)
  sourceProtocolId String?
  sourceProtocol   Protocol?        @relation("ProtocolCopies", fields: [sourceProtocolId], references: [id], onDelete: SetNull)
  copies           Protocol[]       @relation("ProtocolCopies")
  /// The protocol this one is a new version of ("Create a new version" in the protocol editor). Training scenarios
  /// stay with the version they were written for; recommendations fall back along this link (lib/recommendations.ts).
  versionOfId      String?
  versionOf        Protocol?        @relation("ProtocolVersions", fields: [versionOfId], references: [id], onDelete: SetNull)
  versions         Protocol[]       @relation("ProtocolVersions")
  createdById      String?
  createdBy        User?            @relation("ProtocolCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  steps            ProtocolStep[]
  scenarios        Scenario[]
  scans            Scan[]

  @@index([organizationId, isPublished])
  @@index([category])
  @@index([sourceProtocolId])
  @@index([versionOfId])
  @@index([createdById])
  @@map("protocol")
}

// One checkable step. key is a stable slug, unique per protocol (seed upserts and AI step ids use it).

model ProtocolStep {
  id                String                 @id @default(cuid())
  protocolId        String
  protocol          Protocol               @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  key               String
  order             Int
  textAr            String
  textEn            String
  rationaleAr       String
  rationaleEn       String
  /// What a photo must show to judge this step; null when the step is not visually checkable.
  criteriaAr        String?
  criteriaEn        String?
  referenceLabel    String?
  referenceUrl      String?
  isMandatory       Boolean                @default(true)
  /// A violation is an automatic high risk (e.g. recapping a needle).
  isCritical        Boolean                @default(false)
  /// 1..3 (validated in code; lib/scoring.ts clamps)
  weight            Int                    @default(1)
  /// Can a still photo show it? Only these steps go to the scan AI.
  visualCheck       Boolean                @default(false)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  options           ScenarioOption[]
  scanResults       ScanStepResult[]
  simulationResults SimulationStepResult[]

  @@unique([protocolId, key])
  @@index([protocolId, order])
  @@map("protocol_step")
}

// A simulation scenario that trains one protocol. Global when organizationId is null.

model Scenario {
  id               String              @id @default(cuid())
  slug             String              @unique
  protocolId       String
  protocol         Protocol            @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  organizationId   String?
  organization     Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  titleAr          String
  titleEn          String
  introAr          String
  introEn          String
  settingAr        String
  settingEn        String
  difficulty       Difficulty          @default(beginner)
  estimatedMinutes Int                 @default(5)
  isPublished      Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  stages           ScenarioStage[]
  attempts         SimulationAttempt[]

  @@index([protocolId])
  @@index([organizationId, isPublished])
  @@map("scenario")
}

model ScenarioStage {
  id         String             @id @default(cuid())
  scenarioId String
  scenario   Scenario           @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  order      Int
  kind       StageKind          @default(single)
  promptAr   String
  promptEn   String
  contextAr  String?
  contextEn  String?
  options    ScenarioOption[]
  answers    SimulationAnswer[]

  @@index([scenarioId, order])
  @@map("scenario_stage")
}

// An answer option. Maps to a protocol step (stepId) when choosing it right or wrong says something
// about that step; feedback always explains why it is right or wrong.

model ScenarioOption {
  id         String        @id @default(cuid())
  stageId    String
  stage      ScenarioStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  order      Int
  textAr     String
  textEn     String
  isCorrect  Boolean       @default(false)
  /// Choosing this (wrong) option violates its step critically.
  isCritical Boolean       @default(false)
  stepId     String?
  step       ProtocolStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
  feedbackAr String
  feedbackEn String

  @@index([stageId, order])
  @@index([stepId])
  @@map("scenario_option")
}

model SimulationAttempt {
  id             String                 @id @default(cuid())
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The user's active organization when the attempt started (null = individual trainee).
  organizationId String?
  organization   Organization?          @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  scenarioId     String
  scenario       Scenario               @relation(fields: [scenarioId], references: [id], onDelete: Restrict)
  status         AttemptStatus          @default(in_progress)
  startedAt      DateTime               @default(now())
  completedAt    DateTime?
  durationSec    Int?
  score          Int?
  riskLevel      RiskLevel?
  /// Short personal debrief, generated in the user's locale (the other column stays null).
  debriefAr      String?
  debriefEn      String?
  answers        SimulationAnswer[]
  stepResults    SimulationStepResult[]

  @@index([userId, completedAt])
  /// A person's attempt history, newest first (lib/reports personal history).
  @@index([userId, startedAt])
  @@index([organizationId, startedAt])
  @@index([organizationId, completedAt])
  @@index([scenarioId])
  @@index([riskLevel])
  @@map("simulation_attempt")
}

model SimulationAnswer {
  id         String            @id @default(cuid())
  attemptId  String
  attempt    SimulationAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  stageId    String
  /// Restrict: a stage with answers is history. Unpublish / version a scenario that has attempts
  /// instead of deleting its stages or options (optionIds would dangle).
  stage      ScenarioStage     @relation(fields: [stageId], references: [id], onDelete: Restrict)
  optionIds  String[]
  isCorrect  Boolean
  answeredAt DateTime          @default(now())

  @@unique([attemptId, stageId])
  @@index([stageId])
  @@map("simulation_answer")
}

// Per-step outcome of a completed attempt, written once by the simulations feature when the attempt
// completes (lib/scoring.ts simulationStepOutcomes). Stored, not recomputed, so dashboards can aggregate
// weak steps across many attempts with one indexed query.

model SimulationStepResult {
  attemptId String
  attempt   SimulationAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  stepId    String
  step      ProtocolStep      @relation(fields: [stepId], references: [id], onDelete: Restrict)
  compliant Boolean
  /// The step was violated by choosing a critical wrong option.
  critical  Boolean           @default(false)

  @@id([attemptId, stepId])
  @@index([stepId, compliant])
  @@map("simulation_step_result")
}

// A smart compliance scan of one area (1..4 photos) against one protocol. Scans are institutional audits:
// always owned by an organization (no personal scans). Deleting a user keeps the scan (examiner -> null);
// deleting an organization goes through lib/data-lifecycle.ts (bucket objects too).

model Scan {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Department (Better Auth team)
  teamId         String?
  team           Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  /// null once the examiner's account is deleted (the audit trail stays with the institution)
  examinerId     String?
  examiner       User?            @relation("ScanExaminer", fields: [examinerId], references: [id], onDelete: SetNull)
  protocolId     String
  protocol       Protocol         @relation(fields: [protocolId], references: [id], onDelete: Restrict)
  /// Free text typed by the examiner, e.g. "Room 12 sink".
  areaLabel      String
  status         ScanStatus       @default(draft)
  /// Model that actually answered (may be a server-side fallback).
  aiModel        String?
  /// Raw structured AI output, kept for audit.
  aiRaw          Json?
  overallNotesAr String?
  overallNotesEn String?
  score          Int?
  riskLevel      RiskLevel?
  startedAt      DateTime         @default(now())
  analyzedAt     DateTime?
  finalizedAt    DateTime?
  finalizedById  String?
  finalizedBy    User?            @relation("ScanFinalizer", fields: [finalizedById], references: [id], onDelete: SetNull)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  photos         ScanPhoto[]
  stepResults    ScanStepResult[]

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  /// Institution reports: one institution's finalised scans in a finalizedAt range (lib/reports).
  @@index([organizationId, status, finalizedAt])
  @@index([examinerId, createdAt])
  @@index([protocolId])
  @@index([teamId])
  @@index([riskLevel])
  @@index([finalizedById])
  // Photo retention job: finalised scans older than "scans.photoRetentionDays" (lib/settings.ts).
  @@index([status, finalizedAt])
  @@map("scan")
}

// A photo in the bucket (presigned PUT). scanId is null until it is attached to a scan. Rows cascade with
// their scan, the bucket object does not: delete scans with lib/data-lifecycle.ts deleteScansWithPhotos().

model ScanPhoto {
  id             String       @id @default(cuid())
  scanId         String?
  scan           Scan?        @relation(fields: [scanId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// null once the uploader's account is deleted
  uploadedById   String?
  uploadedBy     User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  storageKey     String       @unique
  mime           String
  bytes          Int
  width          Int
  height         Int
  createdAt      DateTime     @default(now())

  @@index([scanId])
  @@index([organizationId, createdAt])
  @@index([uploadedById, createdAt])
  @@map("scan_photo")
}

model ScanStepResult {
  id             String        @id @default(cuid())
  scanId         String
  scan           Scan          @relation(fields: [scanId], references: [id], onDelete: Cascade)
  stepId         String
  step           ProtocolStep  @relation(fields: [stepId], references: [id], onDelete: Restrict)
  aiVerdict      StepVerdict?
  aiConfidence   Float?
  evidenceAr     String?
  evidenceEn     String?
  finalVerdict   FinalVerdict?
  /// The person who decided this step: an override of the AI verdict, a confirmation of it, or a hand answer for a
  /// step the AI does not judge. A confirmation keeps finalVerdict == aiVerdict: count overrides by comparing the two
  /// (scanStepOutcome in lib/scoring.ts), never by overriddenById != null.
  overriddenById String?
  overriddenBy   User?         @relation("ScanStepOverride", fields: [overriddenById], references: [id], onDelete: SetNull)
  note           String?
  updatedAt      DateTime      @updatedAt

  @@unique([scanId, stepId])
  @@index([stepId, finalVerdict])
  @@index([overriddenById])
  @@map("scan_step_result")
}

// Every AI call (daily limits, admin cost panel, failure log).

model AiCall {
  id             String        @id @default(cuid())
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  kind           AiCallKind
  model          String
  status         AiCallStatus
  inputTokens    Int?
  outputTokens   Int?
  costUsd        Decimal?      @db.Decimal(12, 6)
  latencyMs      Int?
  /// e.g. refused, rate_limited, overloaded, timeout, invalid_output (lib/ai/errors.ts)
  errorCode      String?
  /// What the call was for, e.g. targetType "scan" + targetId of that scan.
  targetType     String?
  targetId       String?
  createdAt      DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@index([createdAt])
  @@index([status, createdAt])
  @@map("ai_call")
}

// Who did what (admin panel actions, role changes, bans, deletes, impersonation, finalisations).

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Snapshot when the row was written (user.name, platform user.role). No e-mail address.
  /// When the actor deletes their account the row is de-identified (note 08, B4): actorId -> null (FK),
  /// and the user purge (lib/account/purge.ts purgeUserData) clears actorName and ip and sets actorDeleted.
  actorName    String?
  actorRole    String?
  /// true = the actor's account was deleted (UI: common.deletedUser). actorId and actorName both null with
  /// actorDeleted false = written by the system (UI: common.system).
  actorDeleted Boolean  @default(false)
  /// dotted, e.g. "user.ban", "organization.delete", "scan.finalize"
  action       String
  targetType   String
  targetId     String?
  meta         Json?
  ip           String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
  @@map("audit_log")
}

// Admin-editable settings (lib/settings.ts), e.g. "ai.dailyLimitPerUser".

model AppSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
  @@map("app_setting")
}

// Fixed-window counters that must outlive Better Auth's own rateLimit table (Better Auth deletes every row
// there older than its longest window, 60 s, so a 15-minute limit cannot live in it: note 08, F2).
// Written only through lib/app-rate-limit.ts takeAppRateLimit() (one atomic upsert). Keys carry no raw
// e-mail: "email-send:<sha256>", "account-delete-request:<userId>", "account-delete-confirm:<userId>", ...
// Rows older than 2 days are deleted by the daily job.

model AppRateLimit {
  key         String   @id
  count       Int
  windowStart DateTime

  @@index([windowStart])
  @@map("app_rate_limit")
}
